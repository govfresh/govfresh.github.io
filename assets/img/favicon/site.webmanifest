---
---
{
  "name": "{{ site.title }}",
  "short_name": "{{ site.title }}",
  "description": "{{ site.description }}",
  "start_url": "/",
  "display": "browser",
  "theme_color": "{{ site.data.site.theme.dark }}",
  "background_color": "{{ site.data.site.theme.dark }}",
  "icons": [
    {
      "src": "/assets/img/favicon/android-icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/assets/img/favicon/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
